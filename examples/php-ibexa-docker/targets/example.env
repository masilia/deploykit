# Example target for the Ibexa Docker profile. Inventory: versioned, NO secret.
# See docs/targets.md for the keys and their aliases.

DEPLOY_HOST=srv.client.example.com
DEPLOY_USER=acme                  # the CloudPanel site user: it owns the deployment root and runs docker
DEPLOY_PORT=22
DEPLOY_PATH=/home/acme/ibexa

DOMAIN=www.client.example.com
HOSTING=shared
TLS_MODE=cloudpanel
PROXY_PORT=8081
SITE_USER=acme
CONTRACT=ondemand
