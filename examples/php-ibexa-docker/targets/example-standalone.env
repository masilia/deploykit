# Example target for the standalone variant: a server with no CloudPanel. Inventory: versioned, NO secret.
DEPLOY_HOST=srv.client.example.com
DEPLOY_USER=deploy                # a user of the docker group; `bootstrap` creates the deployment root for it, as root
DEPLOY_PORT=22
DEPLOY_PATH=/opt/ibexa
ROOT_USER=root
DOMAIN=www.client.example.com     # its A record must point at the server before `bootstrap`
TLS_MODE=certbot
CONTRACT=ondemand
