# Target: an Ibexa site on a CloudPanel server (no secret). Canonical keys, see docs/targets.md.
HOST=srv.example.com
SSH_PORT=22
ROOT_USER=root
DOMAIN=www.example.com
SITE_USER=acme
# The site folder: releases/, shared/ and the current link live here, the document root is current/public.
PATH_ON_SERVER=/home/acme/htdocs/www.example.com
