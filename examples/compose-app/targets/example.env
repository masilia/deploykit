# Example target for the compose profile. Inventory: versioned, NO secret.
# See docs/targets.md for the keys and their aliases.

# --- SSH target ---
DEPLOY_HOST=srv.client.example.com
DEPLOY_USER=deploy
DEPLOY_PORT=22
DEPLOY_PATH=/opt/app

# --- Inventory / supervision markers ---
DOMAIN=app.client.example.com
# HOSTING: vps = dedicated instance; shared = multi-site (CloudPanel)
HOSTING=vps
# TLS_MODE: certbot (default) or cloudpanel (with PROXY_PORT)
TLS_MODE=certbot
# PROXY_PORT=8081
# SITE_USER=app-client        # required when TLS_MODE=cloudpanel (user of the reverse-proxy site)
# CONTRACT: supervised = scheduled healthcheck in CI; ondemand = on request
CONTRACT=ondemand
# ROLLOUT_ORDER=10
