# deploykit manifest for [[ .Project ]]: a Next.js (standalone output) site built on this machine, uploaded as a release
# folder, run by pm2 behind a CloudPanel Node.js site. Generated by `deploykit init`.
# Every section is documented in examples/nextjs-cloudpanel/deploykit.yaml.
# Check it with `deploykit validate`, then `deploykit doctor -t <target>`.

version: 1
project: [[ .Project ]]

inventory: targets/             # one target per file `targets/<id>.env`, no secret

# --- Artifact: built here from a clean `git archive` export, uploaded as a release folder -------------------
artifact:
  type: release-dir
  source: { ref: HEAD }         # `--from-worktree` builds the working tree instead
  build:
    node: [[ q .NodeVersion ]]
[[- if .Has "checks" ]]
    checks:                     # run before the build; `--skip-checks` skips them
[[- range .Checks ]]
      - [[ q . ]]
[[- end ]]
[[- end ]]
    install: npm ci             # `--skip-install` skips it
    command: npm run build
    env:
      NEXT_PUBLIC_SITE_URL: "{{ target.site_url }}"   # baked at build time (sitemap, robots)
  assemble:                     # each line copies `from` to `to` inside the release folder
    - { from: ".next/standalone/.", to: "." }
    - { from: ".next/static",       to: ".next/static" }
    - { from: "public",             to: "public", replace: true }   # standalone only contains part of it
  keep: [[ .Keep ]]  # releases kept on the server
[[ if .Has "smoke" ]]
# --- The release is started here and fetched before anything is uploaded ----------------------------------------
smoke:
  start:
    command: node server.js     # run inside the release folder
    env: { NODE_ENV: production, HOSTNAME: "0.0.0.0" }
    port: { range: [3300, 3799] }              # a random free port
    remove_env: [NODE_OPTIONS]
  follow_redirects: 3
  expect: [200, 206]
  paths: [[ flow .SmokePaths ]]
[[ end ]]
# --- Runtime on the server -----------------------------------------------------------------------------------
runtime:
  type: pm2
  name: "{{ project }}"
  entry: server.js
  cwd: current                  # symlink to the active release
  env:
    NODE_ENV: production
    PORT: "{{ target.app_port }}"
    HOSTNAME: "0.0.0.0"         # the port stays closed on the firewall, only nginx reaches it
  max_memory: 700M
  on_boot:
    systemd_unit: "pm2-{{ target.site_user }}"
  switch: atomic_symlink        # ln -sfn <release> current.tmp && mv -Tf current.tmp current
  preflight:
    same_arch: true             # `sharp` is compiled for the build machine: local uname -sm = remote
    port_free_on_first_deploy: true
  health:
    where: server               # run on the server, not from this machine
    path: [[ q .HealthPath ]]
    expect: 200
    tries: 30
    interval: 1s
  on_failure:
    rollback: previous_release
    show_logs: "pm2 logs {{ runtime.name }} --lines 30 --nostream"

# --- Ingress: a CloudPanel Node.js site ------------------------------------------------------------------------
ingress:
  type: cloudpanel
  site:
    type: nodejs                # clpctl site:add:nodejs
    node_version: [[ q .NodeVersion ]]
    app_port: "{{ target.app_port }}"
    user: "{{ target.site_user }}"
    user_password: { generate: 24, show_once: true }   # only for CloudPanel's file manager
  port_discovery:               # ports already taken on the server
    listening: "ss -ltnH | awk '{print $4}' | sed 's/.*://'"
    declared: "grep -rhoE '(127\\.0\\.0\\.1|localhost|0\\.0\\.0\\.0):[0-9]{2,5}' /etc/nginx/sites-enabled /etc/nginx/conf.d"
    pick: first_free_from_requested
    persist_in_target: true     # writes app_port back to the target file
  tls:
    command: lets-encrypt
    require_dns: [ "{{ target.domain }}", "www.{{ target.domain }}" ]
    san_www: if_dns_resolves
    on_failure: warn            # the site is still served with a self-signed certificate

# --- SSH access ---------------------------------------------------------------------------------------------------
ssh:
  commands_on_stdin: true
  site_user_prelude: 'export NVM_DIR="$HOME/.nvm"; [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"; [ -f ~/.profile ] && . ~/.profile'
  provision_user: root          # `clpctl` requires root (or a sudoer)
  connect_timeout: 10s
  retries: 2                    # a connection that cannot be established is retried (2 s, then 4 s)
  install_key_for_site_user:
    public_key: auto            # the key the server really accepts
