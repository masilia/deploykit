# deploykit manifest for [[ .Project ]]: a Docker Compose stack, images built from a git tag and pushed to a registry.
# Generated by `deploykit init`. Every section is documented in examples/compose-app/deploykit.yaml.
# Check it with `deploykit validate`, then `deploykit doctor -t <target>`.

version: 1
project: [[ .Project ]]  # compose project name: volumes are `[[ .Project ]]_<volume>`

inventory: targets/             # one target per file `targets/<id>.env`, no secret
global_config: deploy.env       # editor-side, git-ignored, mode 600: REGISTRY, GHCR_USER, GHCR_TOKEN (see deploy.env.example)

# --- Artifact: images built from a git tag (never from the worktree) and pushed to a registry ---------------
artifact:
  type: image
  registry: "{{ config.REGISTRY }}"          # an explicit host/namespace such as ghcr.io/my-org, set in deploy.env
  registry_login:
    host: ghcr.io
    user: "{{ config.GHCR_USER }}"
    token: "{{ config.GHCR_TOKEN }}"         # passed to `docker login --password-stdin`
  source:
    ref: "v{{ version }}"
    create_tag_if_missing: true              # the tag is created on HEAD when absent
  images:
[[- range .Images ]]
    - { name: [[ q .Name ]], dockerfile: [[ q .Dockerfile ]], context: . }
[[- end ]]
  tags: ["{{ version }}", "sha-{{ commit7 }}"]
  ensure_release: true                       # `deploy` builds and pushes the images when the registry lacks them

# --- Runtime: Docker Compose on the server ----------------------------------------------------------------
runtime:
  type: compose
  min_compose: "2.24"
  files: [[ flow .RuntimeFiles ]]
[[- if .OverrideWhenCloudPanel ]]
  overrides:
    - { when: "target.tls_mode == 'cloudpanel'", file: [[ q .Override ]] }
[[- end ]]

  services:                                  # roles: proxy, app, worker, db, cache, realtime
[[- range .Services ]]
    - { name: [[ q .Name ]], role: [[ q .Role ]] }
[[- end ]]
[[ if .AppService ]]
  # App commands run in a one-off container of the `[[ .AppService ]]` service (`compose run --rm [[ .AppService ]] ...`).
  app:
    service: [[ q .AppService ]]
    commands:
[[- if .MigrateCommand ]]
      migrate: [[ q .MigrateCommand ]]
[[- else ]]
      # migrate: php bin/console doctrine:migrations:migrate -n   # add your command, then add `migrate` to the steps below
[[- end ]]
[[ end ]]
  health:
    wait: { timeout: 180s, interval: 5s }    # until every service is running and healthy
    probes:
      - { name: app, http: "{{ base_url }}[[ .HealthPath ]]" }

  update:
    steps: [[ flow .UpdateSteps ]]
    disk: { path: docker_root, min_free_mb: "{{ env.MIN_FREE_MB | default: 2000 }}" }
    on_failure:
      rollback: previous_version             # AUTO_ROLLBACK=0 in the server .env disables it; the schema is not undone
    cleanup: { keep_versions: [current, previous], prune_dangling: true }
[[- if .MonitoringCron ]]
    after: [monitoring_cron]
[[- end ]]
  install:
    steps: [[ flow .InstallSteps ]]
    reminders:
[[- if .Has "backup" ]]
      - "Copy BACKUP_PASSPHRASE to a password manager OFF this server: without it the backups are unreadable."
[[- else ]]
      - "Keep a copy of the server .env off this server."
[[- end ]]

# --- Server .env ---------------------------------------------------------------------------------------------
env:
  file: .env
[[- if .EnvTemplate ]]
  template: [[ q .EnvTemplate ]]  # copied on first install, mode 600
[[- end ]]
[[- if .Secrets ]]
  secrets:                                   # generated when absent or CHANGE_ME*, never overwritten
[[- range .Secrets ]]
    [[ .Key ]]: { hex_bytes: [[ .Bytes ]] }
[[- end ]]
[[- end ]]
  from_target_on_deploy: [REGISTRY, PROXY_PORT]  # `deploy` rewrites them in the remote .env (PROXY_PORT: the port bootstrap picked)
[[ if .Has "backup" ]]
# --- Backups (encrypted with gpg, verified before they are kept) ----------------------------------------------
data:
  database:
    type: postgres
    service: [[ q .DBService ]]
    dump: 'pg_dump -U "$POSTGRES_USER" -Fc "$POSTGRES_DB"'
    verify: 'pg_restore -l'                  # an unreadable dump aborts the backup
[[- if .Volumes ]]
  volumes: [[ flow .Volumes ]]  # archived through a throwaway container, read-only
[[- end ]]
  include_files: [.env]
backup:
  name_prefix: [[ .Project ]]-backup  # <prefix>-<YYYYMMDD-HHMMSS>[-monthly].tar.gpg + .sha256
  dir: ./backups
  encryption: { type: gpg, cipher: AES256, passphrase_key: BACKUP_PASSPHRASE }
  verify: [sha256, decrypt_and_list]         # a backup that cannot be read back is deleted
  retention: { daily_days: 7, monthly_days: 30, monthly_on_day: 1 }
  min_free_mb: "{{ env.BACKUP_MIN_FREE_MB | default: 500 }}"
  offsite: { rsync_target: "{{ env.BACKUP_RSYNC_TARGET }}", optional: true, on_failure: warn }   # empty = no copy
  schedule: "30 2 * * *"
[[ end ]]
[[- if .Has "restore-test" ]]
restore_test:                                # restores the newest backup into a throwaway database, then drops it
  schedule: "0 4 2 * *"
  throwaway_database: restore_check          # never the live database
  checks:
    min_tables_ratio: 0.9
[[ end ]]
[[- if .Has "monitor" ]]
# --- Supervision: runs on the server, outside the application -------------------------------------------------
monitor:
  schedule: "*/5 * * * *"
  state_file: log/monitor.state
  fail_threshold: "{{ env.MONITOR_FAILS | default: 2 }}"
  remind_hours: "{{ env.MONITOR_REMIND_HOURS | default: 6 }}"
  skip_while_locked: true
  checks:
    - services                               # every service running and healthy
    - { http: "{{ base_url }}[[ .HealthPath ]]" }
    - { disk_free_mb_warn: "{{ env.MIN_FREE_MB | default: 2000 }}" }
[[- if .CloudPanelPossible ]]
  base_url_when_cloudpanel: "http://127.0.0.1:{{ target.proxy_port }}"   # with a `Host:` header
[[- end ]]
notify:
  slack_webhook: "{{ env.SLACK_WEBHOOK_URL }}"   # empty = silent
[[ end ]]
[[- if .Has "crons" ]]
crons: []                                    # project jobs, one marked crontab block per deployment root. For example:
# - { name: nightly-report, schedule: "15 1 * * *", run: "compose run --rm [[ if .AppService ]][[ .AppService ]][[ else ]]app[[ end ]] <command>" }
[[ end ]]
# --- Ingress ---------------------------------------------------------------------------------------------------
[[- if eq .Ingress "select" ]]
# `select` + `variants`: the target's TLS_MODE (certbot or cloudpanel) picks the variant. The cloudpanel variant needs
# SITE_USER and PROXY_PORT in the target; see docs/targets.md.
ingress:
  select: "{{ target.tls_mode | default: certbot }}"
  variants:
    cloudpanel:
[[ indent 6 (include "cloudpanel") ]]
    certbot:
[[ indent 6 (include "standalone") ]]
[[- else if eq .Ingress "cloudpanel" ]]
ingress:
[[ indent 2 (include "cloudpanel") ]]
[[- else ]]
ingress:
[[ indent 2 (include "standalone") ]]
[[- end ]]

# --- What is sent to the server next to the compose files ---------------------------------------------------
# The server also receives the deploykit binary of the same version.
sync:
  files: [[ flow .SyncFiles ]]
  never: [deploy.env, secrets/, targets/]    # secrets and other targets' inventory never reach a server

fleet:
  rollout_order_key: ROLLOUT_ORDER           # ascending, default 50, then id
  contract_key: CONTRACT                     # supervised | ondemand; `--supervised` filters on it
  backup_stale_hours: 26

ssh:
  connect_timeout: 10s
  retries: 2                                 # a connection that cannot be established is retried (2 s, then 4 s)
[[- if .CloudPanelPossible ]]
  provision_user: root                       # only for the CloudPanel variant
[[- end ]]
