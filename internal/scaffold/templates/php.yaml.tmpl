# deploykit manifest for [[ .Project ]]: a PHP ([[ .Framework ]]) application built on this machine, uploaded as a release folder and
# served by the PHP-FPM pool of a CloudPanel PHP site (a "simple" installation: no Redis, no Solr, no Varnish). Generated by
# `deploykit init`. Every section is documented in examples/php-ibexa/deploykit.yaml.
# Check it with `deploykit validate`, then `deploykit doctor -t <target>`.

version: 1
project: [[ .Project ]]

inventory: targets/             # one target per file `targets/<id>.env`, no secret

# --- Artifact: built here from a clean `git archive` export, then sent as it is -----------------------------------
artifact:
  type: release-dir
  source: { ref: HEAD }         # a tag works as well: --ref v1.4.0
  build:
[[- if .Workdir ]]
    workdir: [[ q .Workdir ]]           # the application lives in a subfolder of the repository
[[- end ]]
[[- if .BuildImage ]]
    image: [[ q .BuildImage ]]      # the build runs in a throwaway container: only Docker is needed here
[[- else ]]
    # image: some/image:tag       # build in a throwaway container instead (PHP, composer, node and yarn come from the image)
[[- end ]]
    env:                        # what the kernel needs to boot while compiling; the real values live in shared/.env.local on the server
      APP_ENV: prod
      APP_DEBUG: "0"
[[- if eq .Framework "ibexa" ]]
      HTTPCACHE_PURGE_TYPE: local   # Ibexa HTTP cache: only a comment in a fresh .env, and prod refuses to boot without it
[[- end ]]
      # Add any other variable the kernel reads without a default (the build prints "Environment variable not found: X").
    # composer's own auto-scripts may call `yarn install` and `cache:clear`: they are skipped, the steps below do the work.
    install: composer install --no-dev --optimize-autoloader --no-interaction --no-scripts
[[- if .AssetCommands ]]
    command: |                  # one script, run with `set -e`
[[- range .AssetCommands ]]
      [[ . ]]
[[- end ]]
[[- end ]]
  assemble:
    - { from: [[ q .AssembleFrom ]], to: ".", exclude: [/var, /node_modules, /tests, /public/var, .env.local, .git] }
  keep: 3                       # releases kept on the server

# --- Runtime: the PHP-FPM pool of the CloudPanel site -------------------------------------------------------------
runtime:
  type: php-fpm
  php_version: [[ q .PHPVersion ]]
  web_root: [[ q .WebRoot ]]              # the CloudPanel document root is current/[[ .WebRoot ]]
  shared:                       # kept in shared/ and linked into every release: they survive a deploy
[[- range .Shared ]]
    - { path: [[ q .Path ]], kind: [[ .Kind ]][[ if .Required ]], required: true[[ end ]] }
[[- end ]]
  writable: [var/cache]         # created empty in each release (a Symfony cache holds absolute paths: never sent)
  env: { APP_ENV: prod }
  commands:                     # named, run in a release folder as the site user; {{ php }} is php[[ .PHPVersion ]]
[[- range .Commands ]]
    [[ .Name ]]: [[ q .Run ]]
[[- end ]]
  php_extensions: auto          # the ext-* of composer.json are checked on the server (reported, never installed)
  prepare: [[ flow .Prepare ]]   # in the new release, before the switch: a failure stops the deploy
  after_switch: []              # after the switch and after a rollback: a failure is a warning
  reload: none                  # none is enough with the template deploykit creates ($realpath_root)
  health:
    path: [[ q .HealthPath ]]
    expect: [200, 301, 302]
    tries: 20
    interval: 2s                # asked of 127.0.0.1:8080 (the site's backend) with the site's Host header

# --- Ingress: a CloudPanel PHP site ---------------------------------------------------------------------------------
ingress:
  type: cloudpanel
  site:
    type: php
    php_version: [[ q .PHPVersion ]]
    vhost_template: { name: "deploykit-{{ project }}", base: "Symfony 7" }   # derived: root directory current/[[ .WebRoot ]]
    user: "{{ target.site_user }}"
    user_password: { generate: 24, show_once: true }   # only for CloudPanel's file manager
  tls:
    command: lets-encrypt
    require_dns: ["{{ target.domain }}"]
    on_failure: warn

ssh:
  commands_on_stdin: true
  provision_user: root
  connect_timeout: 10s
  retries: 2
  install_key_for_site_user:
    public_key: auto
